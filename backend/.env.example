# PashuRakshak Backend Environment Variables Template
PROJECT_NAME="PashuRakshak Botad"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL 16)
# Standard asyncpg format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/pashurakshak_db
TEST_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/pashurakshak_test_db

# Connection Pooling Configuration
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Security & JWT Secrets (Generate with `openssl rand -hex 32`)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OFFLINE_AUTH_VALIDITY_DAYS=7

# CORS Allowed Origins (JSON array or comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Storage Paths
STORAGE_LOCAL_ROOT="../storage"
IMPORT_STORAGE_DIR="../storage/imports"
LABEL_STORAGE_DIR="../storage/labels"
DISEASE_ATTACHMENTS_DIR="../storage/attachments"

# Integration Adapters
BHARAT_PASHUDHAN_MODE="DISABLED"
SMS_PROVIDER_MODE="SIMULATED"
